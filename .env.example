# Copy this file to .env.local and fill in your values

# React Bits Pro license key — required for installing premium components/blocks
REACTBITS_LICENSE_KEY=

# Web3Forms access key — contact form submissions are emailed to the inbox
# this key was created for (https://web3forms.com). Public-safe, but kept in
# env so the destination can be swapped without a code change.
VITE_WEB3FORMS_ACCESS_KEY=
